{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Núcleo",
  "version": "0.1.0",
  "identifier": "com.dailydevlog.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "title": "Núcleo",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "quick-capture",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "title": "Captura rápida",
        "url": "index.html#/capture",
        "width": 560,
        "height": 248,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "visible": false
      },
      {
        "label": "focus-widget",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "title": "Enfoque",
        "url": "index.html#/widget",
        "width": 330,
        "height": 128,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KiboCode",
    "copyright": "© 2026 KiboCode",
    "homepage": "https://nucleo.kibocode.lat",
    "category": "DeveloperTool",
    "shortDescription": "Tu jornada, en orden. Para desarrolladores y estudiantes.",
    "longDescription": "Planifica tu jornada, registra bloqueos y aprendizajes, y genera reportes diarios y semanales. Todo se guarda en tu equipo: sin cuenta, sin servidor y sin telemetría.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
